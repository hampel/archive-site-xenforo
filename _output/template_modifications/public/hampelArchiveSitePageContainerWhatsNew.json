{
    "template": "PAGE_CONTAINER",
    "description": "Remove what's new link in the page header for guests",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#(<a href=\"\\{\\{ link\\('whats-new'\\) \\}\\}\".*</a>)#simU",
    "replace": "<xf:if is=\"$xf.visitor.user_id\">$0</xf:if>"
}