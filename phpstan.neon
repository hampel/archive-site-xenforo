includes:
    - vendor/hampel/xenforo-phpstan/extension.neon
    # types an entity built with makeEntity() or createEntity() from the name it is given
    - vendor/hampel/xenforo-test-framework/extension.neon

parameters:
    level: 5

    paths:
        - .

    excludePaths:
        # Scanned through the Composer autoloader already; scanning the directory as well lets a
        # dependency's scaffold shadow the add-on's own classes of the same name.
        analyseAndScan:
            - vendor (?)
        # Generated by XenForo, and not the add-on's code. And two that cannot be analysed:
        # tests/Fixtures is a stand-in sibling extension whose XFCP_ parent exists only once the
        # isolated test registers it, and XF/Mail/Mail.php declares its class once per XenForo
        # version, so analysed against 2.3 the 2.2 branch is an incompatible override - which
        # PHPStan refuses to let be ignored.
        analyse:
            - tests/Fixtures
            - XF/Mail/Mail.php
            - _output (?)
            - _releases (?)
            - _data (?)

    # An option is a magic property with no static type. Reading options is most of what the
    # guest-hiding half does, and crating XF\Options alone leaves entity columns checked.
    universalObjectCratesClasses:
        - XF\Options

    ignoreErrors:
        # The relation is added by XF/Entity/User.php, whose @property-read declares it. The
        # analyser carries an extension's methods up to the core class and not its properties,
        # so a value typed XF\Entity\User does not see it.
        -
            identifier: property.notFound
            message: '#^Access to an undefined property XF\\Entity\\User::\$ArchivedUser\.$#'
        # XenForo documents install() and uninstall() as returning StepResult|null, and a setup
        # that runs in one step returns nothing, which is null.
        -
            identifier: return.missing
            path: Setup.php
            count: 2
        # Defence in depth, documented in CLAUDE.md: an empty list would build NOT IN (), so the
        # fallback stays even though the early return above means it never applies.
        -
            identifier: ternary.alwaysTrue
            path: Job/ArchiveUsers.php
            count: 1
        # pluckFrom() replaces each entity with the column's value, and the analyser still types
        # what fetch() returns as the finder's entities.
        -
            identifier: argument.type
            message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(XF\\(?:Entity\\User|Mvc\\Entity\\Entity)\): mixed\)\|null, ''intval'' given\.$#'
        # JobResult answers completed through __get().
        -
            identifier: property.notFound
            message: '#^Access to an undefined property XF\\Job\\JobResult::\$completed\.$#'
            path: tests/Unit/Job/ArchiveUsersTest.php
            count: 2
        # PHPStan remembers a static call's result across the setConfig() between the two
        # assertions, so the second reads as already decided.
        -
            identifier: method.alreadyNarrowedType
            path: tests/Unit/Config/ProtectedUsersTest.php
            count: 1
        # The placeholders the scaffold wrote. Feature's is its only test, and phpunit.xml fails
        # an empty suite.
        -
            identifier: method.alreadyNarrowedType
            paths:
                - tests/Unit/ExampleTest.php
                - tests/Feature/ExampleTest.php
